<%= sidebar_turbo_frame_tag do %>
  <%= turbo_stream_from :rooms %>
  <%= turbo_stream_from Current.user, :rooms %>

  <div class="sidebar__container overflow-y overflow-hide-scrollbar"
      data-controller="badge-dot sidebar-lists"
      data-badge-dot-unread-class="unread"
      data-action="rooms-list:unread@window->badge-dot#update rooms-list:read@window->badge-dot#update turbo:submit-start->turbo-frame#unpermanize">
    <turbo-frame id="direct_rooms_control" target="_top">
      <%# Four circles; tapping one shows its list right below. Rooms is where the menu starts. %>
      <div class="sidebar-lists">
        <div class="directs sidebar-lists__tabs gap">
          <%= sidebar_list_tab "rooms", "Rooms", "list-rooms.svg" %>
          <%= sidebar_list_tab "dms", "DMs", "list-dms.svg" %>
          <%= sidebar_list_tab "threads", "Threads", "list-threads.svg" %>
          <%= sidebar_list_tab "members", "Members", "list-members.svg" %>
        </div>

        <section id="dms_list" class="sidebar-lists__panel" hidden data-sidebar-lists-target="panel" data-name="dms" aria-label="DMs">
          <%= link_to new_rooms_direct_path, class: "btn sidebar-lists__new txt-small", data: { turbo_frame: "_self" } do %>
            <%= image_tag "add.svg", size: 16, aria: { hidden: "true" } %>
            <span>New DM</span>
          <% end %>

          <div id="direct_rooms" class="sidebar-lists__rows" data-controller="sorted-list" data-action="rooms-list:unread@window->sorted-list#updateItem">
            <%= render partial: "users/sidebars/rooms/direct", collection: @direct_memberships, as: :membership, cached: true %>
          </div>
          <p class="sidebar-lists__empty txt-small">No DMs yet. Open Members to send one.</p>
        </section>

        <section id="threads_list" class="sidebar-lists__panel" hidden data-sidebar-lists-target="panel" data-name="threads" aria-label="Threads">
          <div id="thread_rows" class="sidebar-lists__rows" data-controller="sorted-list">
            <% @threads.each do |thread| %>
              <%= render "users/sidebars/thread_row", thread: thread, unread: @unread_thread_ids.include?(thread.id) %>
            <% end %>
          </div>
          <p class="sidebar-lists__empty txt-small">No threads in the last 30 days. Start one with "Reply in thread" on any message.</p>
        </section>

        <section id="members_list" class="sidebar-lists__panel" hidden data-sidebar-lists-target="panel" data-name="members" aria-label="Members">
          <%# Two ways to see members; plain radio buttons switch them, so it works without any script %>
          <div class="members-views">
            <div class="members-views__switch txt-small" role="radiogroup" aria-label="Show members">
              <input type="radio" name="members_view" id="members_view_az" checked>
              <label for="members_view_az">A–Z</label>
              <input type="radio" name="members_view" id="members_view_nearby">
              <label for="members_view_nearby">Nearby</label>
            </div>

            <div class="members-views__az">
              <div class="sidebar-lists__members">
                <% @members.each do |member| %>
                  <%= link_to user_path(member), class: "sidebar-lists__member txt-small", title: member.name do %>
                    <span class="avatar">
                      <%= image_tag fresh_user_avatar_path(member), size: 48, loading: "lazy", aria: { hidden: "true" } %>
                    </span>
                    <span class="overflow-ellipsis"><%= member.name.split.first %></span>
                  <% end %>
                <% end %>
              </div>
              <p class="sidebar-lists__count txt-small"><%= pluralize @members.size, "member" %></p>
            </div>

            <div class="members-views__nearby">
              <%= render "users/sidebars/nearby", nearby: Nearby.new(@members) %>
            </div>
          </div>
        </section>
      </div>
    </turbo-frame>

    <%# Not hidden in the markup, so the rooms show even before the circles' script runs %>
    <div id="rooms_list" class="rooms position-relative flex flex-column gap" data-sidebar-lists-target="panel" data-name="rooms" aria-label="Rooms">
      <div id="shared_rooms" contents data-controller="sorted-list">
        <% @other_memberships.each do |membership| %>
          <%= render "users/sidebars/rooms/shared", room: membership.room, unread: membership.unread? %>
        <% end %>
      </div>

      <%# Local chats ("📍 Mumbai area") after the club's own rooms, so they don't break its order %>
      <div id="local_rooms" contents>
        <% @local_memberships.each do |membership| %>
          <%= render "users/sidebars/rooms/shared", room: membership.room, unread: membership.unread? %>
        <% end %>
      </div>

      <% if Current.user.administrator? || !Current.account.settings.restrict_room_creation_to_administrators? %>
        <%= link_to new_rooms_open_path, class: "rooms__new-btn btn room align-center gap txt-reversed", aria: { label: "New Chat Room" } do %>
          <%= image_tag "add.svg", size: 20, aria: { hidden: "true" }, style: "view-transition-name: new-room" %>
        <% end %>
      <% end %>
    </div>

    <button class="btn sidebar__toggle" data-action="toggle-class#toggle">
      <%= image_tag "menu.svg", size: 20, aria: { hidden: "true" } %>
      <span class="for-screen-reader">Open menu</span>
    </button>
  </div>

  <div class="flex align-end sidebar__tools gap justify-end">
    <%= link_to user_profile_path, class: "btn avatar flex-item-no-shrink sidebar__tool" do %>
      <%= image_tag fresh_user_avatar_path(Current.user), size: 48, aria: { hidden: "true" }, style: "view-transition-name: avatar-#{Current.user.id}" %>
      <span class="for-screen-reader">My Settings</span>
    <% end %>

    <%= link_to edit_account_path, class: "btn align-center gap txt-reversed sidebar__tool" do %>
      <%= image_tag "settings.svg", size: 20, aria: { hidden: "true" }, style: "view-transition-name: account-settings" %>
      <span class="for-screen-reader">Account Settings</span>
    <% end %>
  </div>
<% end %>
