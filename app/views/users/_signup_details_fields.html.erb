<div class="txt-small txt-subtle txt-align-center margin-block-start">Optional: tell the community about you</div>

<div class="flex align-start gap">
  <span class="btn" style="visibility: hidden" aria-hidden="true"></span>
  <label class="flex align--center gap flex-item--grow txt-large input input--actor">
    <%= form.text_area :bio, class: "input", placeholder: "A few words about yourself…", maxlength: 200, rows: 3,
          aria: { label: "Bio" } %>
    <%= image_tag "bio.svg", aria: { hidden: "true" }, size: 24, class: "colorize--black" %>
  </label>
</div>

<%= render "users/city_picker", form: form, user: form.object, placeholder: "Your city (optional)" %>

<div class="flex align-start gap">
  <span class="btn" style="visibility: hidden" aria-hidden="true"></span>
  <label class="flex align--center gap flex-item--grow txt-large input input--actor">
    <%= form.text_area :books, class: "input", placeholder: "Some books I like", maxlength: 300, rows: 3,
          aria: { label: "Some books I like" } %>
    <%= image_tag "common-file-text.svg", aria: { hidden: "true" }, size: 24, class: "colorize--black" %>
  </label>
</div>

<% { x_handle: [ "X username", "brand-x.svg" ], instagram_handle: [ "Instagram username", "brand-instagram.svg" ] }.each do |field, (label, icon)| %>
  <div class="flex align-center gap">
    <span class="btn" style="visibility: hidden" aria-hidden="true"></span>
    <label class="flex align-center gap flex-item-grow txt-large input input--actor">
      <%= form.text_field field, class: "input", placeholder: "@username", maxlength: 200,
            autocomplete: "off", aria: { label: label }, data: { "1p-ignore": true } %>
      <%= image_tag icon, aria: { hidden: "true" }, size: 24, class: "colorize--black" %>
    </label>
  </div>
<% end %>
