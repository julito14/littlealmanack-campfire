<div class="txt-small txt-subtle txt-align-center margin-block-start">Optional: tell the club about you</div>

<div class="flex align-start gap">
  <span class="btn" style="visibility: hidden" aria-hidden="true"></span>
  <label class="flex align--center gap flex-item--grow txt-large input input--actor">
    <%= form.text_area :bio, class: "input", placeholder: "A few words about yourself…", maxlength: 200, rows: 3,
          aria: { label: "Bio" } %>
    <%= image_tag "bio.svg", aria: { hidden: "true" }, size: 24, class: "colorize--black" %>
  </label>
</div>

<div class="flex align-center gap">
  <span class="btn" style="visibility: hidden" aria-hidden="true"></span>
  <label class="flex align-center gap flex-item-grow txt-large input input--actor">
    <%= form.text_field :location, class: "input", placeholder: "City, Country", maxlength: 60,
          autocomplete: "off", aria: { label: "Location" }, data: { "1p-ignore": true } %>
    <%= image_tag "web.svg", aria: { hidden: "true" }, size: 24, class: "colorize--black" %>
  </label>
</div>

<div class="flex align-start gap">
  <span class="btn" style="visibility: hidden" aria-hidden="true"></span>
  <label class="flex align--center gap flex-item--grow txt-large input input--actor">
    <%= form.text_area :books, class: "input", placeholder: "Some books I like", maxlength: 300, rows: 3,
          aria: { label: "Some books I like" } %>
    <%= image_tag "common-file-text.svg", aria: { hidden: "true" }, size: 24, class: "colorize--black" %>
  </label>
</div>
