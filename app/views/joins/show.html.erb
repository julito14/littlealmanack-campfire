<% @page_title = "Join" %>

<section class="txt-align-center">
  <div class="panel flex flex-column gap">
    <%= account_logo_tag style: "center txt-xx-large" %>
    <h1 class="txt-large margin-none" style="text-wrap: balance"><%= Current.account.name %></h1>
    <p class="margin-none">The community isn't open for new sign-ups right now.</p>
    <p class="margin-none txt-subtle">Already a member? <%= link_to "Sign in", new_session_path %></p>
  </div>
</section>

<%= render "accounts/help_contact" %>
